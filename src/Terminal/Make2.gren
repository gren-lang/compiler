module Terminal.Make2 exposing
    ( Config
    , Error(..)
    , run
    , prettifyError
    )


import Stream
import Stream.Log
import Dict exposing (Dict)
import Task exposing (Task)
import Bytes exposing (Bytes)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Compiler.Outline as Outline exposing (Outline)
import Cli.Report as Report exposing (Report)
import Terminal.PackageInstall as PackageInstall exposing (PackageResolution)
import Cli.PrettyPrinter as PP
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Parse.Module as PM
import Compiler.Parse.Context as Context
import String.Parser.Advanced as Parser
import Compiler.Ast.Source as ParsedAst
import Compiler.ModuleName as ModuleName


type alias Config =
    { stdout : Stream.Writable Bytes
    , fsPermission : FileSystem.Permission
    , pathToString : Path -> String
    , project : PackageResolution
    }


type Error
    = NoSources
    | ParseFailure { path : Path, error : String }
    | ParseDependencyFailure { package : PackageName, error : String }


type alias ParsedResolution =
    { projectPath : Path
    , outline : Outline
    , rootSources : Dict String ParsedFile
    , dependencies : Dict String { path : Path, outline : Outline.PkgOutline, sources : Dict String ParsedAst.Module }
    }


type alias ParsedFile =
    { path : Path
    , ast : ParsedAst.Module
    }


run : Config -> Task Error String
run { stdout, fsPermission, pathToString, project } =
    if Dict.isEmpty project.rootSources then
        Task.fail NoSources

    else
        Dict.values project.rootSources
            |> Array.keepIf (\{ path } -> path.extension == "gren")
            |> Array.foldl
                (parseApplicationSource stdout pathToString project.projectPath)
                (Task.succeed [])
            |> Task.andThen
                (\parsedRoots ->
                    Dict.foldl
                        (\_ { path, outline, sources } acc ->
                            acc
                                |> Task.andThen
                                    (\parsedFiles ->
                                        Dict.foldl
                                            (\modName src acc_ ->
                                                if String.startsWith "Gren.Kernel." modName then
                                                    acc_

                                                else
                                                    parseDependencySource stdout outline.name src acc_
                                            )
                                            (Task.succeed parsedFiles)
                                            sources
                                    )
                                |> Task.andThen
                                    (\parsedFiles ->
                                        Stream.Log.line stdout (PackageName.toString outline.name)
                                            |> Task.map (\_ -> parsedFiles)
                                    )
                        )
                        (Task.succeed parsedRoots)
                        project.dependencies
                )
            |> Task.map (String.join "\n")


parseApplicationSource stdout pathToString projectPath { path, data = source } previous =
    previous
        |> Task.andThen
            (\previousFiles ->
                let
                    relPath =
                        pathRelativeFrom projectPath path
                in
                -- TODO: diagnostics should be written to stderr
                Stream.Log.string stdout (pathToString relPath ++ " ")
                    |> Task.andThen (\_ -> parseFn source)
                    |> Task.andThen
                        (\mod ->
                            Stream.Log.line stdout "\u{2714}"
                                |> Task.map
                                    (\_ ->
                                        Array.pushLast
                                            (ModuleName.toString <| .value <| ParsedAst.moduleName mod)
                                            previousFiles
                                    )
                        )
                    |> Task.onError
                        (\errs ->
                            Stream.Log.line stdout "x"
                                |> Task.andThen
                                    (\_ ->
                                        Task.fail <|
                                            ParseFailure
                                                { path = relPath
                                                , error = PM.errorsToString source errs 
                                                }
                                    )
                        )
            )


parseFn source =
    -- TODO: use correct package name
    when Parser.run (PM.parser PackageName.example) Context.empty source is
        Ok mod -> 
            Task.succeed mod

        Err errs ->
            Task.fail errs


parseDependencySource stdout packageName source previous =
    previous
        |> Task.andThen
            (\previousFiles ->
                -- TODO: diagnostics should be written to stderr
                parseFn source
                    |> Task.map
                        (\mod ->
                            Array.pushLast
                                (ModuleName.toString <| .value <| ParsedAst.moduleName mod)
                                previousFiles
                        )
                    |> Task.mapError
                        (\errs ->
                            ParseDependencyFailure
                                { package = packageName
                                , error = PM.errorsToString source errs 
                                }
                        )
            )


-- TODO: add to gren-lang/node?
pathRelativeFrom : Path -> Path -> Path
pathRelativeFrom base absolute =
    let
        commonPrefix =
            findCommonPrefix 0 (Array.pushLast base.filename base.directory) absolute.directory
    in
    if commonPrefix > 0 then
        { root = ""
        , directory = Array.dropFirst commonPrefix absolute.directory
        , filename = absolute.filename
        , extension = absolute.extension
        }

    else
        absolute


findCommonPrefix : Int -> Array String -> Array String -> Int
findCommonPrefix count left right =
    when { l = Array.popFirst left, r = Array.popFirst right } is
        { l = Just { first = lFirst, rest = lRest }, r = Just { first = rFirst, rest = rRest} } ->
            if lFirst == rFirst then
                findCommonPrefix (count + 1) lRest rRest

            else
                count

        _ ->
            count


prettifyError : Error -> Report
prettifyError error =
    when error is
        NoSources ->
            Report.create
                "NO SOURCE FILES"
                Nothing
                ( PP.words "I can't seem to find any files in this project."
                )

        ParseFailure { path, error = message } ->
            Report.create
                "FAILED TO PARSE"
                (Just path)
                ( PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )

        ParseDependencyFailure { package, error = message } ->
            Report.create
                ("FAILED TO COMPILE " ++ PackageName.toString package)
                Nothing
                ( PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )
